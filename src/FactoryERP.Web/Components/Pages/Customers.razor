@page "/customers"
@attribute [Authorize(Policy = Permissions.CustomersManage)]

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0">Clientes y Cuentas por Cobrar (CxC)</h3>
        <small class="text-muted">Minoristas, salones de belleza y distribuidores mayoristas</small>
    </div>
    <button class="btn btn-brand btn-sm" @onclick="OpenNewModal"><i class="bi bi-person-plus me-1"></i> Nuevo Cliente</button>
</div>

<div class="card p-3">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr><th>Cliente</th><th>RNC / Cédula</th><th>Segmento</th><th>Teléfono</th><th>Límite Crédito</th><th>Saldo CxC</th><th class="text-end">Acciones</th></tr>
        </thead>
        <tbody>
            @foreach (var c in _customers)
            {
                <tr>
                    <td class="fw-semibold">@c.Name</td>
                    <td>@c.RncCedula</td>
                    <td><span class="badge bg-info-subtle text-body">@c.CustomerType</span></td>
                    <td>@c.Phone</td>
                    <td>RD$ @c.CreditLimit.ToString("N2")</td>
                    <td class="fw-bold @(c.CurrentBalance > 0 ? "text-warning" : "text-success")">RD$ @c.CurrentBalance.ToString("N2")</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditModal(c)"><i class="bi bi-pencil"></i></button>
                        @if (c.CurrentBalance > 0)
                        {
                            <button class="btn btn-sm btn-outline-success" @onclick="() => OpenPayModal(c)">Cobrar</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (_showForm)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.45);">
        <div class="modal-dialog"><div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Cliente</h5><button class="btn-close" @onclick="() => _showForm = false"></button></div>
            <div class="modal-body">
                <div class="mb-2"><label class="form-label small">Nombre / Razón Social</label><input class="form-control" @bind="_editing.Name" /></div>
                <div class="row g-2 mb-2">
                    <div class="col-6"><label class="form-label small">RNC / Cédula</label><input class="form-control" @bind="_editing.RncCedula" /></div>
                    <div class="col-6">
                        <label class="form-label small">Segmento</label>
                        <select class="form-select" @bind="_editing.CustomerType">
                            @foreach (var t in Enum.GetValues<CustomerType>()) { <option value="@t">@t</option> }
                        </select>
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6"><label class="form-label small">Teléfono</label><input class="form-control" @bind="_editing.Phone" /></div>
                    <div class="col-6"><label class="form-label small">WhatsApp</label><input class="form-control" @bind="_editing.WhatsApp" /></div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6"><label class="form-label small">Límite Crédito (RD$)</label><input type="number" class="form-control" @bind="_editing.CreditLimit" /></div>
                    <div class="col-6"><label class="form-label small">Días Crédito</label><input type="number" class="form-control" @bind="_editing.CreditDays" /></div>
                </div>
                <div><label class="form-label small">Dirección</label><input class="form-control" @bind="_editing.Address" /></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => _showForm = false">Cancelar</button>
                <button class="btn btn-brand" @onclick="SaveAsync">Guardar</button>
            </div>
        </div></div>
    </div>
}

@if (_showPay && _payTarget != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.45);">
        <div class="modal-dialog modal-sm"><div class="modal-content">
            <div class="modal-header"><h6 class="modal-title">Cobrar a @_payTarget.Name</h6><button class="btn-close" @onclick="() => _showPay = false"></button></div>
            <div class="modal-body">
                <label class="form-label small">Monto Abono (RD$)</label>
                <input type="number" step="0.01" class="form-control mb-2" @bind="_payAmount" />
                <label class="form-label small">Método</label>
                <select class="form-select mb-2" @bind="_payMethod">
                    <option value="@PaymentMethod.Cash">Efectivo</option>
                    <option value="@PaymentMethod.BankTransfer">Transferencia</option>
                    <option value="@PaymentMethod.Card">Tarjeta</option>
                </select>
                <label class="form-label small">Referencia</label>
                <input class="form-control" @bind="_payRef" />
            </div>
            <div class="modal-footer"><button class="btn btn-brand btn-sm" @onclick="ConfirmPayAsync">Registrar Cobro</button></div>
        </div></div>
    </div>
}
