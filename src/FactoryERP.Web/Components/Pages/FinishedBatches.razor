@page "/batches"
@attribute [Authorize(Policy = Permissions.ProductionManage)]
@inject IProductService ProductService
@inject IBusinessProfileService BusinessProfileService

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h3 class="fw-bold mb-0">Lotes Terminados (Trazabilidad FEFO)</h3>
        <small class="text-muted">Existencias por lote, costo real unitario y alertas de vencimiento</small>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <input class="form-control form-control-sm" style="width: 220px;" placeholder="Buscar lote o producto..." @bind="_search" @bind:event="oninput" />
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" id="batchesStockSwitch" @bind="_onlyWithStock" />
            <label class="form-check-label small" for="batchesStockSwitch">Solo con existencia</label>
        </div>
    </div>
</div>

@{
    var utcToday = DateTime.UtcNow.Date;
    int withStockCount = _batches.Count(b => b.QuantityRemaining > 0);
    int expiringSoonCount = _batches.Count(b => b.QuantityRemaining > 0 && b.ExpirationDate.HasValue && b.ExpirationDate.Value.Date >= utcToday && b.ExpirationDate.Value.Date <= utcToday.AddDays(30));
    int expiredCount = _batches.Count(b => b.QuantityRemaining > 0 && b.ExpirationDate.HasValue && b.ExpirationDate.Value.Date < utcToday);
}
<div class="d-flex flex-wrap gap-2 mb-3 small">
    <span class="badge bg-primary-subtle text-primary">Con existencia: @withStockCount</span>
    <span class="badge bg-warning-subtle text-warning-emphasis">Por vencer (&le;30d): @expiringSoonCount</span>
    <span class="badge bg-danger-subtle text-danger">Vencidos con stock: @expiredCount</span>
</div>

<div class="card p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Lote</th><th>Producto</th><th>Fabricación</th><th>Vencimiento</th><th>Inicial</th><th>Disponible</th><th>Costo Unit.</th></tr>
            </thead>
            <tbody>
                @foreach (var b in FilteredBatches)
                {
                    <tr class="@(b.QuantityRemaining == 0 ? "text-muted" : "")">
                        <td><code>@b.BatchCode</code></td>
                        <td class="fw-semibold">@b.Product?.Name</td>
                        <td>@b.ProductionDate.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td>
                            @(b.ExpirationDate?.ToLocalTime().ToString("dd/MM/yyyy") ?? "N/A")
                            @if (b.QuantityRemaining > 0 && b.ExpirationDate.HasValue)
                            {
                                var expDate = b.ExpirationDate.Value.Date;
                                if (expDate < utcToday) { <span class="badge bg-danger ms-1">Vencido</span> }
                                else if (expDate <= utcToday.AddDays(30)) { <span class="badge bg-warning text-dark ms-1">Por vencer</span> }
                                else { <span class="badge bg-success-subtle text-success ms-1">Vigente</span> }
                            }
                        </td>
                        <td>@b.InitialQuantity</td>
                        <td class="fw-bold">@b.QuantityRemaining</td>
                        <td>@_currencySymbol @b.UnitCost.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<FinishedBatch> _batches = new();
    private string _currencySymbol = "RD$";
    private string _search = string.Empty;
    private bool _onlyWithStock;

    private IEnumerable<FinishedBatch> FilteredBatches => _batches.Where(b =>
        (!_onlyWithStock || b.QuantityRemaining > 0) &&
        (string.IsNullOrWhiteSpace(_search) ||
         b.BatchCode.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) ||
         (b.Product?.Name.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)));

    protected override async Task OnInitializedAsync()
    {
        var profile = await BusinessProfileService.GetProfileAsync();
        _currencySymbol = string.IsNullOrWhiteSpace(profile.CurrencySymbol) ? "RD$" : profile.CurrencySymbol;
        _batches = await ProductService.GetBatchesAsync();
    }
}
