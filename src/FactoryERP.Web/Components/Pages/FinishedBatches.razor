@page "/batches"
@attribute [Authorize(Policy = Permissions.ProductionManage)]
@inject IProductService ProductService

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h3 class="fw-bold mb-0">Lotes Terminados (Trazabilidad FEFO)</h3>
        <small class="text-muted">Existencias por lote, costo real unitario y fecha de vencimiento</small>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <input class="form-control form-control-sm" style="width: 220px;" placeholder="Buscar lote o producto..." @bind="_search" @bind:event="oninput" />
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" id="batchesStockSwitch" @bind="_onlyWithStock" />
            <label class="form-check-label small" for="batchesStockSwitch">Solo con existencia</label>
        </div>
    </div>
</div>

<div class="card p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Lote</th><th>Producto</th><th>Fabricación</th><th>Vencimiento</th><th>Inicial</th><th>Disponible</th><th>Costo Unit.</th></tr>
            </thead>
            <tbody>
                @foreach (var b in FilteredBatches)
                {
                    <tr class="@(b.QuantityRemaining == 0 ? "text-muted" : "")">
                        <td><code>@b.BatchCode</code></td>
                        <td class="fw-semibold">@b.Product?.Name</td>
                        <td>@b.ProductionDate.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td>@(b.ExpirationDate?.ToLocalTime().ToString("dd/MM/yyyy") ?? "N/A")</td>
                        <td>@b.InitialQuantity</td>
                        <td class="fw-bold">@b.QuantityRemaining</td>
                        <td>RD$ @b.UnitCost.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<FinishedBatch> _batches = new();
    private string _search = string.Empty;
    private bool _onlyWithStock;

    private IEnumerable<FinishedBatch> FilteredBatches => _batches.Where(b =>
        (!_onlyWithStock || b.QuantityRemaining > 0) &&
        (string.IsNullOrWhiteSpace(_search) ||
         b.BatchCode.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) ||
         (b.Product?.Name.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)));

    protected override async Task OnInitializedAsync() => _batches = await ProductService.GetBatchesAsync();
}
