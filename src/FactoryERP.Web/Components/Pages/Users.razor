@page "/users"
@attribute [Authorize(Policy = Permissions.UsersManage)]

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h3 class="fw-bold mb-0">Usuarios del Sistema</h3>
        <small class="text-muted">Control de acceso, roles dinámicos y credenciales</small>
    </div>
    <button class="btn btn-brand btn-sm" @onclick="OpenCreateModal">
        <i class="bi bi-person-plus me-1"></i> Nuevo Usuario
    </button>
</div>

<div class="card p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Nombre</th><th>Correo</th><th>Roles</th><th>Estado</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var u in _users)
                {
                    <tr>
                        <td class="fw-semibold">@u.FullName</td>
                        <td>@u.Email</td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var r in u.Roles)
                                {
                                    <span class="badge bg-secondary-subtle text-body">@r</span>
                                }
                            </div>
                        </td>
                        <td><span class="badge @(u.IsActive ? "bg-success" : "bg-secondary")">@(u.IsActive ? "Activo" : "Inactivo")</span></td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <button class="btn btn-sm btn-outline-secondary" title="Editar usuario" @onclick="() => OpenEditModal(u)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-primary" title="Restablecer clave" @onclick="() => OpenResetModal(u)">
                                    <i class="bi bi-key"></i>
                                </button>
                                <button class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")" @onclick="() => ToggleActiveAsync(u)">
                                    @(u.IsActive ? "Desactivar" : "Activar")
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (_showUserModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.45);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">@(_editingUserId is null ? "Crear Usuario" : "Editar Usuario")</h6>
                    <button type="button" class="btn-close" @onclick="() => _showUserModal = false"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label small fw-semibold">Nombre Completo</label>
                    <input class="form-control form-control-sm mb-2" @bind="_fullName" />

                    @if (_editingUserId is null)
                    {
                        <label class="form-label small fw-semibold">Correo Electrónico</label>
                        <input type="email" class="form-control form-control-sm mb-2" @bind="_email" />
                        <label class="form-label small fw-semibold">Contraseña Inicial</label>
                        <input type="password" class="form-control form-control-sm mb-2" @bind="_password" />
                    }
                    else
                    {
                        <div class="small text-muted mb-2">Correo: <strong>@_email</strong></div>
                    }

                    <label class="form-label small fw-semibold d-block mb-1">Roles Asignados</label>
                    <div class="border rounded p-2">
                        @foreach (var role in _availableRoles)
                        {
                            <label class="form-check small mb-1">
                                <input type="checkbox" class="form-check-input"
                                       checked="@_selectedRoles.Contains(role.Name)"
                                       @onchange="e => ToggleRoleSelection(role.Name, e.Value is bool b && b)" />
                                <span class="fw-semibold">@role.Name</span>
                                <span class="text-muted">(@role.Permissions.Count permisos)</span>
                            </label>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="() => _showUserModal = false">Cancelar</button>
                    <button class="btn btn-brand btn-sm" @onclick="SaveUserAsync">Guardar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showResetModal && _resetTarget is not null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.45);">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">Cambiar Clave: @_resetTarget.FullName</h6>
                    <button type="button" class="btn-close" @onclick="() => _showResetModal = false"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label small">Nueva Contraseña</label>
                    <input type="password" class="form-control form-control-sm mb-1" @bind="_newPassword" />
                    <small class="text-muted">Mínimo 8 caracteres, mayúscula, minúscula, número y símbolo.</small>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-brand btn-sm" @onclick="ConfirmResetPasswordAsync">Actualizar Clave</button>
                </div>
            </div>
        </div>
    </div>
}
