@page "/production"
@attribute [Authorize(Policy = Permissions.ProductionManage)]

<div class="@(_detailOrder != null ? "no-print" : "")">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h3 class="fw-bold mb-0">Órdenes de Preparación y Fabricación</h3>
            <small class="text-muted">Simula materiales, controla mermas y registra el consumo real por lote</small>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <input class="form-control form-control-sm" style="width: 210px;" placeholder="Buscar orden, lote o producto..." @bind="_search" @bind:event="oninput" />
            <select class="form-select form-select-sm" style="width: 150px;" @bind="_statusFilter">
                <option value="">Todos los estados</option>
                @foreach (var st in Enum.GetValues<ProductionOrderStatus>())
                {
                    <option value="@st">@st</option>
                }
            </select>
            <button class="btn btn-brand btn-sm" @onclick="OpenCreateModal"><i class="bi bi-plus-lg me-1"></i> Nueva Orden</button>
        </div>
    </div>

    <div class="card p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Orden / Lote</th><th>Producto</th><th>Plan / Esp.</th><th>Resultante Real</th><th>Merma Real</th><th>Costo Unit. Real</th><th>Estado</th><th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in FilteredOrders)
                    {
                        <tr>
                            <td>
                                <strong>@o.OrderNumber</strong>
                                <div class="small text-muted">Lote: @o.BatchCode</div>
                            </td>
                            <td>@o.Product?.Name</td>
                            <td>@o.PlannedQuantity / @o.ExpectedResultingQuantity uds (@o.ExpectedLossMarginPercent.ToString("N1")%)</td>
                            <td>@(o.ActualYieldQuantity?.ToString() ?? "-") uds</td>
                            <td>@(o.ActualLossPercent.HasValue ? $"{o.ActualLossPercent:N2}% ({o.ActualLossQuantity} uds)" : "-")</td>
                            <td>@(o.ActualUnitCost > 0 ? $"{_currencySymbol} {o.ActualUnitCost:N2}" : "-")</td>
                            <td><span class="badge @GetStatusBadge(o.Status)">@o.Status</span></td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-secondary me-1" title="Detalle e impresión" @onclick="() => _detailOrder = o"><i class="bi bi-eye"></i></button>
                                @if (o.Status == ProductionOrderStatus.Draft)
                                {
                                    <button class="btn btn-sm btn-outline-primary me-1" title="Editar borrador" @onclick="() => OpenEditDraftModal(o)"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-sm btn-success me-1" @onclick="() => StartAsync(o.Id)">Iniciar</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => CancelAsync(o.Id)">Cancelar</button>
                                }
                                else if (o.Status == ProductionOrderStatus.InProgress)
                                {
                                    <button class="btn btn-sm btn-brand me-1" @onclick="() => OpenCompleteModal(o)">Completar</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => CancelAsync(o.Id)">Cancelar</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (_showCreate)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.45);">
        <div class="modal-dialog modal-lg"><div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@(_editingOrderId == 0 ? "Planificar Orden de Fabricación" : $"Editar Borrador {_editingOrderNumber}")</h5>
                <button class="btn-close" @onclick="() => _showCreate = false"></button>
            </div>
            <div class="modal-body">
                <div class="row g-2 mb-3">
                    <div class="col-md-5">
                        <label class="form-label small">Fórmula</label>
                        <select class="form-select" @bind="_selectedFormulaId" @bind:after="OnFormulaChangedAsync">
                            @foreach (var f in _formulas) { <option value="@f.Id">@f.Product?.Name - @f.Name (v@(f.Version))</option> }
                        </select>
                    </div>
                    <div class="col-md-3"><label class="form-label small">Cant. a Producir</label><input type="number" class="form-control" @bind="_plannedQuantity" /></div>
                    <div class="col-md-2"><label class="form-label small">Merma (%)</label><input type="number" step="0.5" class="form-control" @bind="_lossMargin" /></div>
                    <div class="col-md-2 d-flex align-items-end"><button class="btn btn-outline-primary w-100" @onclick="SimulateAsync">Simular</button></div>
                </div>
                @if (_simulation != null)
                {
                    <div class="alert @(_simulation.CanProduce ? "alert-success" : "alert-danger") py-2 small">
                        <strong>Resultante esperado:</strong> @_simulation.ExpectedResultingQuantity uds |
                        <strong>Costo Total Est.:</strong> @_currencySymbol @_simulation.EstimatedTotalCost.ToString("N2") |
                        <strong>Unitario Est.:</strong> @_currencySymbol @_simulation.EstimatedUnitCost.ToString("N2")
                    </div>
                    <div class="table-responsive mb-2">
                        <table class="table table-sm small mb-0">
                            <thead><tr><th>Material</th><th>Requerido</th><th>Disponible</th><th>Costo Est.</th></tr></thead>
                            <tbody>
                                @foreach (var m in _simulation.Materials)
                                {
                                    <tr class="@(m.HasSufficientStock ? "" : "table-danger")">
                                        <td>@m.Name</td>
                                        <td>@m.RequiredQuantity.ToString("N2") @UnitConverter.GetShortLabel(m.MaterialUnit)</td>
                                        <td>@m.AvailableStock.ToString("N2")</td>
                                        <td>@_currencySymbol @m.EstimatedTotalCost.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <div class="row g-2 mb-2">
                    <div class="col-md-4"><label class="form-label small">Código de lote</label><input class="form-control form-control-sm" placeholder="Opcional (automático)" @bind="_batchCode" /></div>
                    <div class="col-md-4"><label class="form-label small">Fecha planificada</label><input type="date" class="form-control form-control-sm" @bind="_plannedDate" /></div>
                    <div class="col-md-4"><label class="form-label small">Vencimiento est.</label><input type="date" class="form-control form-control-sm" @bind="_draftExpirationDate" /></div>
                </div>
                <input class="form-control form-control-sm" placeholder="Notas u observaciones de producción..." @bind="_draftNotes" />
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => _showCreate = false">Cerrar</button>
                <button class="btn btn-brand" @onclick="SaveDraftAsync">@(_editingOrderId == 0 ? "Crear Orden (Borrador)" : "Guardar Cambios")</button>
            </div>
        </div></div>
    </div>
}

@if (_showComplete && _completeTarget != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.45);">
        <div class="modal-dialog modal-lg"><div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Completar Orden @_completeTarget.OrderNumber</h5><button class="btn-close" @onclick="() => _showComplete = false"></button></div>
            <div class="modal-body">
                <div class="mb-2 small text-muted">Planificado: @_completeTarget.PlannedQuantity uds | Esperado: @_completeTarget.ExpectedResultingQuantity uds</div>
                <div class="row g-2 mb-3">
                    <div class="col-md-4"><label class="form-label small fw-semibold">Resultante Real (uds)</label><input type="number" class="form-control form-control-sm" @bind="_actualYield" /></div>
                    <div class="col-md-4"><label class="form-label small fw-semibold">CIF Real (@_currencySymbol)</label><input type="number" step="0.01" class="form-control form-control-sm" @bind="_actualOverhead" /></div>
                    <div class="col-md-4"><label class="form-label small fw-semibold">Vencimiento del Lote</label><input type="date" class="form-control form-control-sm" @bind="_expirationDate" /></div>
                </div>
                <h6 class="small fw-bold mb-2">Consumo Real de Materiales</h6>
                <div class="table-responsive mb-2">
                    <table class="table table-sm align-middle small mb-0">
                        <thead class="table-light"><tr><th>Material</th><th>Planificado</th><th>Consumido Real</th><th>Disponible Extra</th></tr></thead>
                        <tbody>
                            @foreach (var line in _completeLines)
                            {
                                <tr>
                                    <td>@line.Name</td>
                                    <td>@line.PlannedQty.ToString("N2") @line.UnitLabel</td>
                                    <td style="width: 150px;"><input type="number" step="0.0001" min="0" class="form-control form-control-sm" @bind="line.ActualQty" /></td>
                                    <td class="text-muted">@line.AvailableStock.ToString("N2") @line.UnitLabel</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <input class="form-control form-control-sm" placeholder="Notas de cierre (opcional)..." @bind="_completionNotes" />
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => _showComplete = false">Cancelar</button>
                <button class="btn btn-brand" @onclick="ConfirmCompleteAsync">Cerrar Lote y Contabilizar</button>
            </div>
        </div></div>
    </div>
}

<ProductionOrderDetailModal Order="_detailOrder" CurrencySymbol="@_currencySymbol" OnClose="() => _detailOrder = null" />
