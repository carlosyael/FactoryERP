@page "/purchases"
@attribute [Authorize(Policy = Permissions.PurchasesManage)]

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h3 class="fw-bold mb-0">Compras de Materias Primas</h3>
        <small class="text-muted">Recepción de insumos por lote con Costo Promedio Ponderado (CPP) e ITBIS @((_taxRate * 100m).ToString("N0"))%</small>
    </div>
    <div class="d-flex gap-2">
        @if (_mrpSuggestions.Count > 0)
        {
            <button class="btn btn-outline-warning btn-sm fw-semibold" @onclick="OpenMrpSuggestionsModal">
                <i class="bi bi-lightbulb me-1"></i> Sugerir MRP (@_mrpSuggestions.Count)
            </button>
        }
        <button class="btn btn-brand btn-sm" @onclick="OpenNewModal"><i class="bi bi-cart-plus me-1"></i> Registrar Compra</button>
    </div>
</div>

@if (_mrpSuggestions.Count > 0)
{
    decimal mrpSubTotal = _mrpSuggestions.Sum(s => s.EstimatedPurchaseSubTotal);
    <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2 py-2 small mb-3">
        <div>
            <strong>Alerta MRP (@_mrpSuggestions.Count insumos):</strong>
            @string.Join(", ", _mrpSuggestions.Take(4).Select(s => $"{s.Name} (+{s.SuggestedPurchaseQuantity:N2} {UnitConverter.GetShortLabel(s.UnitOfMeasure)})"))
            @(_mrpSuggestions.Count > 4 ? $" y {_mrpSuggestions.Count - 4} más" : "")
            <span class="ms-2 text-muted">| Subtotal est.: @_currencySymbol @mrpSubTotal.ToString("N2")</span>
        </div>
        <button class="btn btn-sm btn-dark" @onclick="OpenMrpSuggestionsModal">Cargar faltantes en compra</button>
    </div>
}

<div class="card p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Orden</th><th>Fecha</th><th>Suplidor</th><th>Pago</th><th>SubTotal</th><th>ITBIS</th><th>Total</th></tr>
            </thead>
            <tbody>
                @foreach (var po in _orders)
                {
                    <tr>
                        <td><code>@po.OrderNumber</code></td>
                        <td>@po.PurchaseDate.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td>@po.Supplier?.Name</td>
                        <td>@po.PaymentMethod</td>
                        <td>@_currencySymbol @po.SubTotal.ToString("N2")</td>
                        <td>@_currencySymbol @po.TaxAmount.ToString("N2")</td>
                        <td class="fw-bold">@_currencySymbol @po.Total.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (_showModal)
{
    var summary = ComputePurchasePreview();
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.45);">
        <div class="modal-dialog modal-xl"><div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Registrar Recepción de Compra</h5><button class="btn-close" @onclick="CloseModal"></button></div>
            <div class="modal-body">
                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small">Suplidor</label>
                        <select class="form-select" @bind="_supplierId">
                            @foreach (var s in _suppliers) { <option value="@s.Id">@s.Name</option> }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small">Condición de Pago</label>
                        <select class="form-select" @bind="_paymentMethod">
                            <option value="@PaymentMethod.Cash">Efectivo</option>
                            <option value="@PaymentMethod.BankTransfer">Transferencia</option>
                            <option value="@PaymentMethod.Credit">Crédito (CxP)</option>
                        </select>
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong class="small">Detalle de Materiales y Lotes</strong>
                    <button class="btn btn-sm btn-outline-primary" @onclick="AddLine">+ Línea</button>
                </div>
                @foreach (var line in _lines)
                {
                    <div class="row g-2 mb-2 align-items-center">
                        <div class="col-md-3">
                            <select class="form-select form-select-sm" value="@line.RawMaterialId" @onchange="e => OnMaterialChanged(line, e)">
                                @foreach (var m in _materials) { <option value="@m.Id">@m.Name (@UnitConverter.GetShortLabel(m.UnitOfMeasure))</option> }
                            </select>
                        </div>
                        <div class="col-md-2"><input type="number" step="0.01" class="form-control form-control-sm" placeholder="Cant" @bind="line.Quantity" /></div>
                        <div class="col-md-2"><input type="number" step="0.01" class="form-control form-control-sm" placeholder="Costo" @bind="line.UnitCost" /></div>
                        <div class="col-md-2"><input class="form-control form-control-sm" placeholder="Lote MP (opc.)" @bind="line.BatchCode" /></div>
                        <div class="col-md-2"><input type="date" class="form-control form-control-sm" title="Vencimiento" @bind="line.ExpirationDate" /></div>
                        <div class="col-md-1 d-flex align-items-center justify-content-end gap-1">
                            <input type="checkbox" class="form-check-input mt-0" title="Grava ITBIS" @bind="line.IsTaxable" />
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => _lines.Remove(line)">×</button>
                        </div>
                    </div>
                }
                <input class="form-control form-control-sm mt-2" placeholder="Notas de compra..." @bind="_notes" />
                <div class="alert alert-light border small mt-3 mb-0 d-flex justify-content-between">
                    <span>SubTotal: <strong>@_currencySymbol @summary.SubTotal.ToString("N2")</strong></span>
                    <span>ITBIS (@((_taxRate * 100m).ToString("N0"))%): <strong>@_currencySymbol @summary.Tax.ToString("N2")</strong></span>
                    <span class="text-brand">Total: <strong>@_currencySymbol @summary.Total.ToString("N2")</strong></span>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModal">Cancelar</button>
                <button class="btn btn-brand" @onclick="SaveAsync">Recibir y Contabilizar</button>
            </div>
        </div></div>
    </div>
}
