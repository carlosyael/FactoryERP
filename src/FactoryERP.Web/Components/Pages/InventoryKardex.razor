@page "/kardex"
@attribute [Authorize(Policy = Permissions.RawMaterialsView)]

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h3 class="fw-bold mb-0">Kardex de Inventario</h3>
        <small class="text-muted">Historial cronológico de entradas, salidas y ajustes de materias primas y producto terminado</small>
    </div>
    <div class="d-flex gap-2 no-print">
        <button class="btn btn-outline-secondary btn-sm" @onclick="ClearFiltersAsync">Limpiar</button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="PrintAsync"><i class="bi bi-printer me-1"></i> Imprimir</button>
    </div>
</div>

<div class="card p-3 mb-3 no-print">
    <div class="row g-2 align-items-end">
        <div class="col-md-2">
            <label class="form-label small mb-1">Inventario</label>
            <select class="form-select form-select-sm" @bind="_itemTypeFilter">
                <option value="">Todos</option>
                <option value="RawMaterial">Materias Primas</option>
                <option value="FinishedGood">Producto Terminado</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small mb-1">Movimiento</label>
            <select class="form-select form-select-sm" @bind="_movementTypeFilter">
                <option value="">Todos</option>
                @foreach (var mt in Enum.GetValues<InventoryMovementType>())
                {
                    <option value="@mt">@GetMovementLabel(mt)</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1">Desde</label>
            <input type="date" class="form-control form-control-sm" @bind="_startDate" />
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1">Hasta</label>
            <input type="date" class="form-control form-control-sm" @bind="_endDate" />
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1">Buscar</label>
            <input class="form-control form-control-sm" placeholder="Ref, lote, SKU..." @bind="_search" />
        </div>
        <div class="col-md-1">
            <button class="btn btn-brand btn-sm w-100" @onclick="LoadAsync">Filtrar</button>
        </div>
    </div>
</div>

@{
    decimal totalIn = _movements.Where(m => m.QuantityDelta > 0m).Sum(m => m.TotalValue);
    decimal totalOut = _movements.Where(m => m.QuantityDelta < 0m).Sum(m => m.TotalValue);
}
<div class="d-flex flex-wrap gap-2 mb-3 small">
    <span class="badge bg-primary-subtle text-primary">Movimientos: @_movements.Count</span>
    <span class="badge bg-success-subtle text-success">Entradas: @_currencySymbol @totalIn.ToString("N2")</span>
    <span class="badge bg-danger-subtle text-danger">Salidas: @_currencySymbol @totalOut.ToString("N2")</span>
</div>

<div class="card p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light">
                <tr>
                    <th>Fecha / Hora</th>
                    <th>Tipo</th>
                    <th>Ítem / Lote</th>
                    <th>Referencia</th>
                    <th class="text-end">Cantidad</th>
                    <th class="text-end">Saldo</th>
                    <th class="text-end">Costo Unit.</th>
                    <th class="text-end">Valor</th>
                    <th>Notas / Usuario</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in _movements)
                {
                    string unit = GetUnitLabel(m);
                    <tr>
                        <td class="text-nowrap">@m.MovementDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="badge @GetMovementBadge(m)">@GetMovementLabel(m.MovementType)</span></td>
                        <td>
                            <div class="fw-semibold">
                                <span class="badge bg-secondary-subtle text-body me-1">@(m.ItemType == InventoryItemType.RawMaterial ? "MP" : "PT")</span>
                                @GetItemTitle(m)
                            </div>
                            @if (!string.IsNullOrWhiteSpace(m.BatchCode))
                            {
                                <div class="text-muted">Lote: <code>@m.BatchCode</code></div>
                            }
                        </td>
                        <td><code>@m.Reference</code></td>
                        <td class="text-end fw-bold @(m.QuantityDelta >= 0m ? "text-success" : "text-danger")">
                            @(m.QuantityDelta >= 0m ? "+" : "")@m.QuantityDelta.ToString("N2") @unit
                        </td>
                        <td class="text-end">@m.BalanceAfter.ToString("N2") @unit</td>
                        <td class="text-end">@_currencySymbol @m.UnitCost.ToString("N4")</td>
                        <td class="text-end fw-semibold">@_currencySymbol @m.TotalValue.ToString("N2")</td>
                        <td>
                            <div>@m.Notes</div>
                            @if (!string.IsNullOrWhiteSpace(m.PerformedBy))
                            {
                                <div class="text-muted">Por: @m.PerformedBy</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
