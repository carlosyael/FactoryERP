@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject IBusinessProfileService BusinessProfileService
@inject NavigationManager Navigation

<div class="container d-flex justify-content-center align-items-center min-vh-100 py-4">
    <div class="card shadow-lg border-0 p-4" style="max-width: 420px; width: 100%;">
        <div class="text-center mb-4">
            <div class="brand-logo mx-auto mb-3 shadow-sm" style="width: 60px; height: 60px;">
                @if (!string.IsNullOrWhiteSpace(_profile?.LogoUrl))
                {
                    <img src="@_profile.LogoUrl" alt="@_profile.BusinessName" />
                }
                else
                {
                    <i class="bi bi-stars fs-2"></i>
                }
            </div>
            <h4 class="fw-bold mb-1">@(_profile?.BusinessName ?? "ERP")</h4>
            <p class="text-muted small mb-0">@(_profile?.Tagline ?? "Gestión de Manufactura Capilar")</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger py-2 small">@_errorMessage</div>
        }

        <form action="/login" method="post">
            <AntiforgeryToken />
            <div class="mb-3">
                <label class="form-label small fw-semibold">Correo electrónico</label>
                <input type="email" name="email" class="form-control" required autocomplete="username" placeholder="usuario@comercio.com" />
            </div>
            <div class="mb-4">
                <label class="form-label small fw-semibold">Contraseña</label>
                <input type="password" name="password" class="form-control" required autocomplete="current-password" />
            </div>
            <button type="submit" class="btn btn-brand w-100 py-2 fw-semibold">
                <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
            </button>
        </form>

        <div class="text-center mt-3 pt-3 border-top">
            <a href="/catalogo" class="small text-decoration-none text-brand fw-semibold">
                <i class="bi bi-shop me-1"></i> Ver Catálogo Público
            </a>
        </div>
    </div>
</div>

@code {
    private BusinessProfileDto? _profile;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        _profile = await BusinessProfileService.GetProfileAsync();
        var uri = new Uri(Navigation.Uri);
        string query = uri.Query;
        if (query.Contains("AccountLocked")) _errorMessage = "Cuenta bloqueada temporalmente por intentos fallidos.";
        else if (query.Contains("InactiveUser")) _errorMessage = "Su usuario se encuentra inactivo.";
        else if (query.Contains("InvalidCredentials")) _errorMessage = "Credenciales inválidas. Verifique correo y contraseña.";
    }
}
