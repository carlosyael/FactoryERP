@page "/accounting/journal"
@attribute [Authorize(Policy = Permissions.AccountingView)]

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h3 class="fw-bold mb-0">Libro Diario</h3>
        <small class="text-muted">Asientos automáticos de manufactura/ventas, asientos manuales y gastos</small>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary btn-sm" @onclick="OpenExpenseModal"><i class="bi bi-cash-stack me-1"></i> Registrar Gasto</button>
        <button class="btn btn-brand btn-sm" @onclick="OpenManualModal"><i class="bi bi-plus-lg me-1"></i> Asiento Manual</button>
    </div>
</div>

@foreach (var entry in _entries)
{
    <div class="card p-3 mb-3">
        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
            <div>
                <code>@entry.EntryNumber</code> • <strong>@entry.Concept</strong>
                <small class="text-muted ms-2">@entry.Date.ToLocalTime().ToString("dd/MM/yyyy") | Ref: @entry.Reference</small>
            </div>
            <span class="badge @(entry.Status == JournalEntryStatus.Posted ? "bg-success" : entry.Status == JournalEntryStatus.Draft ? "bg-warning text-dark" : "bg-danger")">
                @entry.Status
            </span>
        </div>
        <table class="table table-sm mb-0">
            <thead><tr><th>Cuenta</th><th>Detalle</th><th class="text-end">Débito</th><th class="text-end">Crédito</th></tr></thead>
            <tbody>
                @foreach (var line in entry.Lines)
                {
                    <tr>
                        <td><code>@line.Account?.Code</code> @line.Account?.Name</td>
                        <td class="small text-muted">@line.Description</td>
                        <td class="text-end">@(line.Debit > 0 ? $"RD$ {line.Debit:N2}" : "")</td>
                        <td class="text-end">@(line.Credit > 0 ? $"RD$ {line.Credit:N2}" : "")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_showExpense)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.45);">
        <div class="modal-dialog modal-sm"><div class="modal-content">
            <div class="modal-header"><h6 class="modal-title">Registrar Gasto Operativo</h6><button class="btn-close" @onclick="() => _showExpense = false"></button></div>
            <div class="modal-body">
                <label class="form-label small">Cuenta de Gasto</label>
                <select class="form-select form-select-sm mb-2" @bind="_expAccountCode">
                    <option value="@AccountCodes.OperatingExpenses">6102 - Gastos Operativos</option>
                    <option value="@AccountCodes.AdministrativeExpenses">6103 - Gastos Administrativos</option>
                    <option value="@AccountCodes.DistributionExpenses">6104 - Envíos y Distribución</option>
                </select>
                <label class="form-label small">Pago Desde</label>
                <select class="form-select form-select-sm mb-2" @bind="_payAccountCode">
                    <option value="@AccountCodes.Cash">1101 - Caja General</option>
                    <option value="@AccountCodes.Bank">1102 - Bancos</option>
                </select>
                <label class="form-label small">Monto (RD$)</label><input type="number" step="0.01" class="form-control form-control-sm mb-2" @bind="_expAmount" />
                <label class="form-label small">Concepto</label><input class="form-control form-control-sm mb-2" @bind="_expConcept" />
                <label class="form-label small">Referencia</label><input class="form-control form-control-sm" @bind="_expRef" />
            </div>
            <div class="modal-footer"><button class="btn btn-brand btn-sm" @onclick="SaveExpenseAsync">Contabilizar</button></div>
        </div></div>
    </div>
}

@if (_showManual)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.45);">
        <div class="modal-dialog modal-lg"><div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Nuevo Asiento Manual</h5><button class="btn-close" @onclick="() => _showManual = false"></button></div>
            <div class="modal-body">
                <div class="row g-2 mb-2">
                    <div class="col-md-8"><label class="form-label small">Concepto</label><input class="form-control" @bind="_concept" /></div>
                    <div class="col-md-4"><label class="form-label small">Referencia</label><input class="form-control" @bind="_reference" /></div>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <strong class="small">Líneas (Débito = Crédito)</strong>
                    <button class="btn btn-sm btn-outline-primary" @onclick="AddManualLine">+ Línea</button>
                </div>
                @foreach (var line in _manualLines)
                {
                    <div class="row g-2 mb-2 align-items-center">
                        <div class="col-md-6">
                            <select class="form-select form-select-sm" @bind="line.AccountId">
                                @foreach (var a in _postableAccounts) { <option value="@a.Id">@a.Code - @a.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-2"><input type="number" step="0.01" class="form-control form-control-sm" placeholder="Débito" @bind="line.Debit" /></div>
                        <div class="col-md-2"><input type="number" step="0.01" class="form-control form-control-sm" placeholder="Crédito" @bind="line.Credit" /></div>
                        <div class="col-md-2 text-end"><button class="btn btn-sm btn-outline-danger" @onclick="() => _manualLines.Remove(line)">×</button></div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => _showManual = false">Cancelar</button>
                <button class="btn btn-brand" @onclick="SaveManualAsync">Mayorizar Asiento</button>
            </div>
        </div></div>
    </div>
}
