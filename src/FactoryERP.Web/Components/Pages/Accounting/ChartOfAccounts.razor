@page "/accounting/accounts"
@attribute [Authorize(Policy = Permissions.AccountingView)]
@inject IChartOfAccountsService ChartService
@inject SweetAlertService Swal

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0">Plan de Cuentas Industrial</h3>
        <small class="text-muted">Activos (MP, WIP, Terminados), Pasivos, Capital, Ingresos, Costos y Gastos</small>
    </div>
    <button class="btn btn-brand btn-sm" @onclick="() => { _newAcc = new AccountingAccount(); _showModal = true; }">
        <i class="bi bi-plus-lg me-1"></i> Nueva Cuenta
    </button>
</div>

<div class="card p-3">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Código</th><th>Nombre</th><th>Grupo</th><th>Tipo</th><th>Estado</th></tr></thead>
        <tbody>
            @foreach (var acc in _accounts)
            {
                <tr class="@(acc.IsControlAccount ? "fw-bold table-light" : "")">
                    <td><code>@acc.Code</code></td>
                    <td>@acc.Name</td>
                    <td>@acc.Group</td>
                    <td>@(acc.IsControlAccount ? "Control" : "Movimiento")</td>
                    <td><span class="badge @(acc.IsActive ? "bg-success" : "bg-secondary")">@(acc.IsActive ? "Activa" : "Inactiva")</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (_showModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.45);">
        <div class="modal-dialog modal-sm"><div class="modal-content">
            <div class="modal-header"><h6 class="modal-title">Nueva Cuenta Contable</h6><button class="btn-close" @onclick="() => _showModal = false"></button></div>
            <div class="modal-body">
                <label class="form-label small">Código</label><input class="form-control mb-2" @bind="_newAcc.Code" />
                <label class="form-label small">Nombre</label><input class="form-control mb-2" @bind="_newAcc.Name" />
                <label class="form-label small">Grupo</label>
                <select class="form-select mb-2" @bind="_newAcc.Group">
                    @foreach (var g in Enum.GetValues<AccountGroup>()) { <option value="@g">@g</option> }
                </select>
                <div class="form-check"><input class="form-check-input" type="checkbox" @bind="_newAcc.IsControlAccount" /><label class="form-check-label small">Cuenta control</label></div>
            </div>
            <div class="modal-footer"><button class="btn btn-brand btn-sm" @onclick="SaveAsync">Crear</button></div>
        </div></div>
    </div>
}

@code {
    private List<AccountingAccount> _accounts = new();
    private AccountingAccount _newAcc = new();
    private bool _showModal;

    protected override async Task OnInitializedAsync() => _accounts = await ChartService.GetAllAsync();

    private async Task SaveAsync()
    {
        try
        {
            await ChartService.CreateAsync(_newAcc);
            _showModal = false;
            _accounts = await ChartService.GetAllAsync();
            await Swal.FireAsync("Cuenta creada", "Plan de cuentas actualizado.", SweetAlertIcon.Success);
        }
        catch (Exception ex) { await Swal.FireAsync("Error", ex.Message, SweetAlertIcon.Error); }
    }
}
