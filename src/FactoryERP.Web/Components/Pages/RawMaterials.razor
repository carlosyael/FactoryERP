@page "/raw-materials"
@attribute [Authorize(Policy = Permissions.RawMaterialsView)]

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h3 class="fw-bold mb-0">Materias Primas e Insumos</h3>
        <small class="text-muted">Ingredientes activos, aceites, fragancias, envases y etiquetas</small>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <input class="form-control form-control-sm" style="width: 190px;" placeholder="Buscar SKU o material..." @bind="_search" @bind:event="oninput" />
        <select class="form-select form-select-sm" style="width: 145px;" @bind="_categoryFilter">
            <option value="">Todas las categorías</option>
            @foreach (var cat in Enum.GetValues<RawMaterialCategory>())
            {
                <option value="@cat">@cat</option>
            }
        </select>
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" id="lowStockSwitch" @bind="_onlyLowStock" />
            <label class="form-check-label small" for="lowStockSwitch">Stock bajo</label>
        </div>
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" id="rawInactiveSwitch" @bind="_showInactive" />
            <label class="form-check-label small" for="rawInactiveSwitch">Inactivos</label>
        </div>
        <a class="btn btn-outline-secondary btn-sm" href="/raw-material-batches">
            <i class="bi bi-layers me-1"></i> Lotes MP
        </a>
        <AuthorizeView Policy="@Permissions.RawMaterialsManage">
            <Authorized>
                <button class="btn btn-brand btn-sm" @onclick="OpenNewModal">
                    <i class="bi bi-plus-lg me-1"></i> Nuevo Material
                </button>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

<div class="card p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>SKU</th>
                    <th>Material</th>
                    <th>Categoría</th>
                    <th>Stock</th>
                    <th>Mínimo</th>
                    <th>Costo Prom.</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in FilteredItems)
                {
                    <tr class="@(item.IsLowStock ? "table-warning" : "")">
                        <td><code>@item.Sku</code></td>
                        <td>
                            <div class="fw-semibold">@item.Name @if (!item.IsActive) { <span class="badge bg-secondary ms-1">Inactivo</span> }</div>
                            <small class="text-muted">@item.Description</small>
                        </td>
                        <td>@item.Category</td>
                        <td class="fw-bold">@item.CurrentStock.ToString("N2") @UnitConverter.GetShortLabel(item.UnitOfMeasure)</td>
                        <td>@item.MinimumStockLevel.ToString("N2")</td>
                        <td>@_currencySymbol @item.AverageCost.ToString("N4")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary me-1" href="/raw-material-batches?rawMaterialId=@item.Id" title="Ver lotes del insumo">
                                <i class="bi bi-layers"></i>
                            </a>
                            <a class="btn btn-sm btn-outline-secondary me-1" href="/kardex?rawMaterialId=@item.Id" title="Ver Kardex">
                                <i class="bi bi-clock-history"></i>
                            </a>
                            <AuthorizeView Policy="@Permissions.RawMaterialsManage">
                                <Authorized>
                                    <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditModal(item)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenAdjustModal(item)">
                                        Ajustar
                                    </button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (_showForm)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.45);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editing.Id == 0 ? "Nueva Materia Prima" : "Editar Materia Prima")</h5>
                    <button type="button" class="btn-close" @onclick="() => _showForm = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2 mb-2">
                        <div class="col-md-4"><label class="form-label small">SKU</label><input class="form-control" @bind="_editing.Sku" /></div>
                        <div class="col-md-8"><label class="form-label small">Nombre</label><input class="form-control" @bind="_editing.Name" /></div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small">Categoría</label>
                            <select class="form-select" @bind="_editing.Category">
                                @foreach (var cat in Enum.GetValues<RawMaterialCategory>())
                                {
                                    <option value="@cat">@cat</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">Unidad</label>
                            <select class="form-select" @bind="_editing.UnitOfMeasure">
                                @foreach (var u in Enum.GetValues<UnitOfMeasure>())
                                {
                                    <option value="@u">@u (@UnitConverter.GetShortLabel(u))</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-4"><label class="form-label small">Stock Inicial</label><input type="number" step="0.01" class="form-control" @bind="_editing.CurrentStock" disabled="@(_editing.Id != 0)" /></div>
                        <div class="col-md-4"><label class="form-label small">Stock Mínimo</label><input type="number" step="0.01" class="form-control" @bind="_editing.MinimumStockLevel" /></div>
                        <div class="col-md-4"><label class="form-label small">Costo Unitario (@_currencySymbol)</label><input type="number" step="0.0001" class="form-control" @bind="_editing.AverageCost" /></div>
                    </div>
                    <div class="mb-2"><label class="form-label small">Descripción</label><textarea class="form-control" rows="2" @bind="_editing.Description"></textarea></div>
                    @if (_editing.Id != 0)
                    {
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="matActiveSwitch" @bind="_editing.IsActive" />
                            <label class="form-check-label small" for="matActiveSwitch">Material activo</label>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showForm = false">Cancelar</button>
                    <button class="btn btn-brand" @onclick="SaveAsync">Guardar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showAdjust && _adjustTarget != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.45);">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">Ajustar Stock: @_adjustTarget.Name</h6>
                    <button type="button" class="btn-close" @onclick="() => _showAdjust = false"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label small">Nuevo Stock (@UnitConverter.GetShortLabel(_adjustTarget.UnitOfMeasure))</label>
                    <input type="number" step="0.01" class="form-control mb-2" @bind="_newStockValue" />
                    <label class="form-label small">Motivo</label>
                    <input class="form-control" @bind="_adjustReason" />
                </div>
                <div class="modal-footer">
                    <button class="btn btn-brand btn-sm" @onclick="ConfirmAdjustAsync">Aplicar</button>
                </div>
            </div>
        </div>
    </div>
}
