@page "/formulas"
@attribute [Authorize(Policy = Permissions.FormulasManage)]

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0">Fórmulas y Recetas Capilares</h3>
        <small class="text-muted">Define materiales, costos, rendimiento base y margen de pérdida estándar</small>
    </div>
    <button class="btn btn-brand btn-sm" @onclick="OpenNewModal"><i class="bi bi-plus-lg me-1"></i> Nueva Fórmula</button>
</div>

<div class="row g-3">
    @foreach (var f in _formulas)
    {
        <div class="col-lg-6">
            <div class="card p-3 h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="badge badge-brand me-1">v@(f.Version)</span>
                        <strong class="fs-6">@f.Name</strong>
                        <div class="small text-muted">Producto: @f.Product?.Name (@f.Product?.Presentation)</div>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEditModal(f)"><i class="bi bi-pencil"></i></button>
                </div>
                <div class="d-flex flex-wrap gap-3 small mb-2">
                    <span>Rendimiento base: <strong>@f.BaseYieldQuantity uds</strong></span>
                    <span>Merma estándar: <strong>@f.StandardLossMarginPercent.ToString("N2")%</strong></span>
                    <span>CIF lote: <strong>RD$ @f.OverheadCostPerBatch.ToString("N2")</strong></span>
                    @if (_formulaSummary.TryGetValue(f.Id, out var summary))
                    {
                        <span>Materiales: <strong>RD$ @summary.MaterialCost.ToString("N2")</strong></span>
                        <span class="text-brand">Unit. est.: <strong>RD$ @summary.UnitCost.ToString("N2")</strong></span>
                    }
                </div>
                <ul class="list-group list-group-flush small">
                    @foreach (var item in f.Items)
                    {
                        <li class="list-group-item px-0 py-1 d-flex justify-content-between">
                            <span>@item.RawMaterial?.Name</span>
                            <span>@item.QuantityRequired.ToString("N2") @UnitConverter.GetShortLabel(item.UnitOfMeasure)</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
</div>

@if (_showModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.45);">
        <div class="modal-dialog modal-lg"><div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@(_editing.Id == 0 ? "Nueva Fórmula" : "Editar Fórmula")</h5>
                <button class="btn-close" @onclick="() => _showModal = false"></button>
            </div>
            <div class="modal-body">
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="form-label small">Producto Terminado</label>
                        <select class="form-select" @bind="_editing.ProductId">
                            @foreach (var p in _products) { <option value="@p.Id">@p.Name (@p.Presentation)</option> }
                        </select>
                    </div>
                    <div class="col-md-4"><label class="form-label small">Nombre Fórmula</label><input class="form-control" @bind="_editing.Name" /></div>
                    <div class="col-md-2"><label class="form-label small">Versión</label><input class="form-control" @bind="_editing.Version" /></div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-md-4"><label class="form-label small">Rendimiento Base (uds)</label><input type="number" class="form-control" @bind="_editing.BaseYieldQuantity" /></div>
                    <div class="col-md-4"><label class="form-label small">Merma Estándar (%)</label><input type="number" step="0.5" class="form-control" @bind="_editing.StandardLossMarginPercent" /></div>
                    <div class="col-md-4"><label class="form-label small">Costo Indirecto/Lote (RD$)</label><input type="number" step="1" class="form-control" @bind="_editing.OverheadCostPerBatch" /></div>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong class="small">Ingredientes y Empaques</strong>
                    <button class="btn btn-sm btn-outline-primary" @onclick="AddItem">+ Agregar Material</button>
                </div>
                @foreach (var item in _items)
                {
                    <div class="row g-2 mb-2 align-items-center">
                        <div class="col-md-6">
                            <select class="form-select form-select-sm" value="@item.RawMaterialId" @onchange="e => OnMaterialSelected(item, e)">
                                @foreach (var m in _materials) { <option value="@m.Id">@m.Name (Stock: @m.CurrentStock.ToString("N2") @UnitConverter.GetShortLabel(m.UnitOfMeasure))</option> }
                            </select>
                        </div>
                        <div class="col-md-2"><input type="number" step="0.01" class="form-control form-control-sm" @bind="item.QuantityRequired" /></div>
                        <div class="col-md-3">
                            <select class="form-select form-select-sm" @bind="item.UnitOfMeasure">
                                @foreach (var u in Enum.GetValues<UnitOfMeasure>()) { <option value="@u">@UnitConverter.GetShortLabel(u)</option> }
                            </select>
                        </div>
                        <div class="col-md-1 text-end"><button class="btn btn-sm btn-outline-danger" @onclick="() => _items.Remove(item)">×</button></div>
                    </div>
                }
                <textarea class="form-control form-control-sm mt-2" rows="2" placeholder="Instrucciones de preparación..." @bind="_editing.Instructions"></textarea>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => _showModal = false">Cancelar</button>
                <button class="btn btn-brand" @onclick="SaveAsync">Guardar Fórmula</button>
            </div>
        </div></div>
    </div>
}
