@using System.Security.Claims
@inject IAppMenuService AppMenuService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime

<div class="nav-scrollable py-2">
    <nav class="nav flex-column px-2 gap-1">
        <AuthorizeView Policy="@Permissions.DashboardView">
            <Authorized>
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </NavLink>
            </Authorized>
        </AuthorizeView>

        @if (_menus != null)
        {
            foreach (var group in _menus.GroupBy(m => m.MenuGroup ?? "General"))
            {
                var groupKey = group.Key;
                bool expanded = _expandedGroups.Contains(groupKey);
                <div class="mt-2">
                    <button type="button"
                            class="nav-group-toggle w-100 border-0 bg-transparent d-flex align-items-center justify-content-between px-2 py-1"
                            aria-expanded="@expanded"
                            @onclick="() => ToggleGroup(groupKey)">
                        <span>@groupKey</span>
                        <i class="bi @(expanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
                    </button>
                    @if (expanded)
                    {
                        <div class="ps-2 d-flex flex-column gap-1 mt-1">
                            @foreach (var menu in group)
                            {
                                <NavLink class="nav-link py-1" href="@menu.Url">
                                    <i class="bi @menu.Icon"></i> @menu.Title
                                </NavLink>
                            }
                        </div>
                    }
                </div>
            }
        }
    </nav>

    <div class="mt-auto p-3 border-top">
        <div class="d-flex align-items-center justify-content-between gap-2">
            <div class="text-truncate">
                <div class="small fw-semibold text-truncate">@_userName</div>
                <div class="text-muted" style="font-size: 0.72rem;">@_userRole</div>
            </div>
            <div class="d-flex align-items-center gap-1">
                <button type="button" class="btn btn-sm btn-outline-secondary border-0" @onclick="ToggleThemeAsync" title="Cambiar tema">
                    <i class="bi @(_isDarkMode ? "bi-sun-fill text-warning" : "bi-moon-stars")"></i>
                </button>
                <form action="/logout" method="post" class="m-0">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="Cerrar sesión">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@code {
    private List<AppMenu>? _menus;
    private readonly HashSet<string> _expandedGroups = new();
    private string _userName = "Usuario";
    private string _userRole = "Sesión activa";
    private bool _isDarkMode;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { _isDarkMode = await JSRuntime.InvokeAsync<string>("getTheme") == "dark"; } catch { }

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _userName = user.FindFirst("FullName")?.Value ?? user.Identity.Name ?? "Usuario";
            var roles = user.FindAll(ClaimTypes.Role).Select(c => c.Value).Distinct().ToList();
            _userRole = roles.Count > 0 ? string.Join(", ", roles) : "Usuario";
            _menus = await AppMenuService.GetAuthorizedMenusAsync(user);
            StateHasChanged();
        }
    }

    private void ToggleGroup(string key)
    {
        if (!_expandedGroups.Remove(key)) _expandedGroups.Add(key);
    }

    private async Task ToggleThemeAsync()
    {
        _isDarkMode = !_isDarkMode;
        await JSRuntime.InvokeVoidAsync("setTheme", _isDarkMode ? "dark" : "light");
    }
}
