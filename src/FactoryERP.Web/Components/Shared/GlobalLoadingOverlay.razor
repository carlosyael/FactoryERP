@inject ILoadingService LoadingService
@implements IDisposable

@if (LoadingService.IsLoading)
{
    <div class="global-loading-backdrop">
        <div class="card p-4 text-center shadow-lg border-0" style="min-width: 240px;">
            <div class="spinner-border text-brand mx-auto mb-3" role="status"></div>
            <div class="fw-semibold">@LoadingService.Message</div>
        </div>
    </div>
}

@code {
    protected override void OnInitialized() => LoadingService.OnStateChanged += HandleStateChanged;
    private void HandleStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => LoadingService.OnStateChanged -= HandleStateChanged;
}
