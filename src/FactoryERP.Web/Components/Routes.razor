@using Microsoft.AspNetCore.Components.Authorization

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated == true)
                    {
                        <LayoutView Layout="typeof(MainLayout)">
                            <div class="container py-5 text-center">
                                <i class="bi bi-shield-lock text-warning display-4 mb-2 d-block"></i>
                                <h3 class="fw-bold">Acceso restringido</h3>
                                <p class="text-muted">Tu rol actual no tiene permisos suficientes para acceder a esta sección.</p>
                                <a href="/" class="btn btn-brand btn-sm">Ir al Panel Principal</a>
                            </div>
                        </LayoutView>
                    }
                    else
                    {
                        <RedirectToLogin />
                    }
                </NotAuthorized>
                <Authorizing>
                    <div class="d-flex justify-content-center align-items-center vh-100">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1, h2, h4" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(MainLayout)">
                <div class="container py-5 text-center">
                    <h2 class="fw-bold">Página no encontrada</h2>
                    <p class="text-muted">La ruta solicitada no existe.</p>
                    <a href="/" class="btn btn-brand">Ir al Panel Principal</a>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
